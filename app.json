{
  "expo": {
    "name": "Nirmaan",
    "slug": "nirmaan-mobile",
    "version": "0.1.0",
    "scheme": "nirmaan",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.mahakagarwal.nirmaan",
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Nirmaan to record your spoken progress report.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
